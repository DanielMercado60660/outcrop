  "tolerance_reasons": "\"\"\"All numerical pass thresholds, with CAMPAIGN reasons.\"\"\"\n\n# Same discrete operator as the float64 judge: float32 accumulation only.\nREFERENCE_RTOL = 1.0e-4\n# Each backend must independently meet 1e-4; triangle inequality allows 2e-4.\nCROSS_RTOL = 2.0e-4\n# CAMPAIGN's exact imaging requirement, in vertical grid cells.\nDEPTH_CELLS = 2\n# Centered FD on a quadratic objective; float32 subtraction sets the limit.\nGRADIENT_RTOL = 1.0e-3\n# Binary-exact half m/s step and dyadic directions avoid input rounding;\n# a quadratic Born objective has no centered-difference truncation error.\nFD_STEP = 0.5\n# Independent float64 oracle self-checks, well above double roundoff.\nORACLE_RTOL = 1.0e-8\n# A zero input has exactly zero output in this linear system.\nZERO_ATOL = 0.0\n# A global amplitude floor prevents accepting a zero image at a known layer.\n# This is only an anti-degeneracy gate; full-image parity remains mandatory.\nMIN_LAYER_FRACTION = 1.0e-3\n",
  "inputs": "All source, velocity, scatter, data arrays quantized once to float32 before the float64 solve; int64 locations; float64 Python scalars",
  "synthetic": "layers_uniform: full scalar piecewise-constant layers (2000/2060/1990 m/s), direct-wave subtracted, migrated in homogeneous 2000 m/s; layers_variable: Born thin signed sheets in smooth heterogeneous background",
  "fd": "3 saved dyadic directions, centered difference, step 0.5 m/s; quadratic loss has zero truncation error",
  "interface_depth_convention": "First grid node of the deeper piecewise-constant layer; sheet depths are their grid rows",
