  "tolerances": {
    "parity": {
      "value": 0.0001,
      "reason": "Campaign float32 relative norm/max-scale parity against float64 SimPEG."
    },
    "adjoint": {
      "value": 1e-05,
      "reason": "Project pass: normalized dot-product residual, Cauchy scale avoids cancellation."
    },
    "gradient": {
      "value": 0.001,
      "reason": "Campaign centered float32 finite-difference directional derivative check."
    },
    "fd_step": {
      "value": 0.01,
      "reason": "g/cc along saved unit direction; quadratic objective has zero centered truncation error; avoids float32 cancellation."
    },
    "chi_fraction": {
      "value": 0.1,
      "reason": "Project pass: absolute chi-squared deviation <=10% of N observations."
    },
    "correlation": {
      "value": 0.7,
      "reason": "Project pass: Pearson correlation of recovered and true cell densities >=0.7."
    },
    "model_error_fraction": {
      "value": 0.2,
      "reason": "Project pass: recovered L2 error <=1.20 times SimPEG error, better solutions are allowed."
    },
    "stationarity": {
      "value": 0.0001,
      "reason": "Normal-equation residual relative to RHS ensures actual minimization at locked beta; avoids rewarding arbitrary data fits."
    },
    "oracle_check": {
      "value": 1e-10,
      "reason": "Float64 stored-array algebra consistency; no implementation involved."
    },
    "oracle_regularization": {
      "value": 1e-12,
      "reason": "Float64 absolute and relative agreement of independent edge construction and SimPEG Hessian."
    },
    "oracle_gradient": {
      "value": 1e-07,
      "reason": "Float64 centered differences of SimPEG's quadratic objective."
    },
    "oracle_fd_step": {
      "value": 1e-05,
      "reason": "Float64 quadratic centered-difference step in g/cc along saved unit direction."
    },
    "beta_root_xtol": {
      "value": 1e-12,
      "reason": "Log-beta scalar discrepancy search precision; cheap float64 reference only."
    }
  },
  "reference": "SimPEG Simulation3DIntegral float64 geoana; L2DataMisfit; WeightedLeastSquares",
  "solver": "Exact SPD quadratic minimizer using scipy Cholesky of SimPEG Hessian; beta chosen by discrepancy principle chi^2=N; unconstrained, no positivity bounds.",
  "conventions": "ENU; z up; mesh top z=0; x fastest, z slowest; gz positive upward; density g/cm^3; gravity mGal; full squared norms, no 1/2.",
  "sources": [
    "Li & Oldenburg (1998), 3-D inversion of gravity data, Geophysics 63, 109-119, doi:10.1190/1.1444302",
    "Installed SimPEG regularization/base.py and utils/model_utils.py (depth_weighting exponent=2)."
  ],
  "input_policy": "All data, probes, directions, noise saved here; implementation receives float32 casts of these arrays.",
  "input_recipes": {
    "mesh": "Uniform cubes, origin=(-nx*h/2,-ny*h/2,-nz*h), top z=0; all cells active.",
    "survey": "12x12 endpoint-inclusive regular surface grid over mesh xy extent; z=10m; upward gz.",
    "noise": "default_rng(case.seed); independent standard normals times 0.015*max(abs(clean)); small has a 0.7..1.4 receiver-order uncertainty multiplier.",
    "probes": "After noise draw: normal(0,0.2) model, normal(0,0.05) reference, unit-normalized standard-normal direction, standard-normal data dual.",
    "truth": "Signed, piecewise-constant rectangular blocks, specified by source array slices and saved in each archive. Auxiliary small case is for derivative and stationarity tests only."
  }
}
